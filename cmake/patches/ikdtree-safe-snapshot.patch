@@ -464,1 +464,26 @@
+bool KD_TREE<PointType>::Snapshot_Points(PointVector &Storage, std::size_t maximum_points)
+{
+    // Frontend is the sole writer. Hold the rebuild pointer lock so the
+    // background worker cannot replace/free nodes during this bounded copy.
+    pthread_mutex_lock(&rebuild_ptr_mutex_lock);
+    try
+    {
+        Storage.clear();
+        if (Root_Node && static_cast<std::size_t>(Root_Node->TreeSize - Root_Node->invalid_point_num) > maximum_points)
+        {
+            pthread_mutex_unlock(&rebuild_ptr_mutex_lock);
+            return false;
+        }
+        flatten(Root_Node, Storage, NOT_RECORD);
+    }
+    catch (...)
+    {
+        pthread_mutex_unlock(&rebuild_ptr_mutex_lock);
+        throw;
+    }
+    pthread_mutex_unlock(&rebuild_ptr_mutex_lock);
+    return true;
+}
